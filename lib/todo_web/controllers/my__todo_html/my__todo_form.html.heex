<.form :let={f} for={@changeset} action={@action}>
  <.input field={f[:title]} type="text" label="Title" />
  <.input field={f[:completed]} type="checkbox" label="Completed" />
  <.input field={f[:description]} type="text" label="description" placeholder="Describe the task" />
  <footer>
    <.button variant="primary">Save My  todo</.button>
    <.button :if={@return_to} href={@return_to}>Cancel</.button>
  </footer>
</.form>
